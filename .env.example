# ZEXVRO root environment
#
# Copy this file to `.env` at the repository root. The root dev scripts load
# this file and pass the same environment to the frontend, NFT API, and optional
# De-pin gateway, so you do not need per-folder `.env` files for local work.

# Frontend / browser-safe values
APP_URL="http://127.0.0.1:3000"
VITE_AWS_REGION="us-east-1"
VITE_NFT_API_URL="https://zexvro-platform-api.zexvro.workers.dev/nft"
NFT_API_PROXY_TARGET="http://127.0.0.1:4101"
VITE_DEPIN_API_URL="/api/depin"
DEPIN_API_PROXY_TARGET="http://127.0.0.1:4102"
VITE_STELLAR_OWNER_ADDRESS=""
GEMINI_API_KEY=""

# Morph/opencode dev proxy. Server-side only: do not rename these to VITE_*.
OPENCODE_PROVIDER="opencode zen"
OPENCODE_MODEL="big-opickle"
OPENCODE_API_KEY=""
OPENCODE_API_URL=""

# NFT API
PORT=4101
NFT_DATA_FILE=".data/nft-service.json"
# file = local JSON (default). dynamo = multi-instance AWS DynamoDB table.
NFT_REPOSITORY="file"
NFT_DYNAMO_TABLE="zexvro-nft"
NFT_DYNAMO_REGION="us-east-1"
NFT_DYNAMO_GSI_WORKSPACE="workspace-index"
NFT_DYNAMO_GSI_IDEMPOTENCY="idempotency-index"
# local = content-addressed HTTP assets (dev only)
# s3 = production media on AWS S3 (+ optional CloudFront CDN base URL)
# pinata = optional legacy public IPFS (requires PINATA_JWT)
NFT_STORAGE_MODE="local"
NFT_LOCAL_ASSET_DIR=".data/assets"
NFT_PUBLIC_BASE_URL="http://127.0.0.1:4101"
NFT_S3_BUCKET=""
NFT_S3_REGION="us-east-1"
# Optional CloudFront or custom HTTPS origin for public object URLs
NFT_CDN_BASE_URL=""
# Optional legacy Pinata. Server-side only. Never commit a real JWT.
PINATA_JWT=""
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
# Comma-separated browser origins for NFT API CORS (studio + public buy + game embeds).
# Add each partner game origin explicitly, e.g. https://game.example.com
CORS_ALLOWED_ORIGINS="http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173,http://localhost:4173"
# NFT API Stellar rail — set to pubnet values for mainnet App Runner:
# STELLAR_RPC_URL="https://mainnet.sorobanrpc.com"
# STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# STELLAR_USDC_CONTRACT="CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA"  # native XLM mainnet (preferred)
# STELLAR_USDC_CONTRACT="CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75"  # Circle USDC mainnet (needs trustline)
# Mainnet WASM (uploaded 2026-07-25): see services/nft-service/mainnet-wasm.env
# NFT_COLLECTION_WASM_HASH="4beb4b6f90eb65291db698ca148903cf1946b20b7ffb381f5b1e25fe779af700"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Default local = native XLM testnet SAC (no trustline). Circle USDC testnet needs a trustline.
STELLAR_USDC_CONTRACT="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
# STELLAR_USDC_CONTRACT="CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA"
NFT_CHECKOUT_TTL_SECONDS=300

# Local Stellar helper. If STELLAR_SPONSOR_SECRET is empty, `npm run dev`
# reads this identity from Stellar CLI at runtime and never writes the secret.
# Hosted/production: inject STELLAR_SPONSOR_SECRET from Secrets Manager; do not
# rely on CLI identity. NODE_ENV=production (or NFT_REQUIRE_SPONSOR=1) fails fast
# without STELLAR_SPONSOR_SECRET + NFT_COLLECTION_WASM_HASH.
ZEXVRO_STELLAR_IDENTITY="zexvro-provider"
STELLAR_SPONSOR_SECRET=""
NFT_REQUIRE_SPONSOR=""
NFT_COLLECTION_WASM_HASH="df42dfceaf2036be527561f313392cee4b756d34745d7cc5f7a1c96936543710"

# Optional De-pin gateway. `npm run dev` starts frontend + NFT API.
# Use `npm run dev:all` when you also want the De-pin gateway.
# Config priority: DEPIN_CONFIG_JSON > DEPIN_CONFIG_URL > DEPIN_CONFIG_PATH
# Copy services/depin/depin.config.example.json → services/depin/depin.config.json first.
DEPIN_CONFIG_PATH="depin.config.json"
DEPIN_CONFIG_URL=""
DEPIN_CONFIG_JSON=""
# memory (single process) | file (multi-instance safe) | redis (not implemented)
# Prefer file for any multi-process or production host.
DEPIN_STATE_BACKEND="file"
DEPIN_STATE_PATH=".data/depin-state.json"
# Silence production warning when intentionally using memory:
# DEPIN_ALLOW_MEMORY_STATE="1"
# Optional: OZ Channels Bearer key for Stellar x402 settle (required when facilitatorUrl is channels.openzeppelin.com)
# Generate testnet key: https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=""
# Alias accepted by the gateway:
# X402_FACILITATOR_API_KEY=""
WEATHER_API_TOKEN=""

# Hosted NFT/De-pin (App Runner)
# VITE_NFT_API_URL="https://zexvro-platform-api.zexvro.workers.dev/nft"
# VITE_DEPIN_API_URL="https://zexvro-platform-api.zexvro.workers.dev/depin"

# --- ZEXVRO Gate / Agent Auth (Rushi) ---
# Local API: services/agent-auth (default port 4103)
AGENT_AUTH_PORT=4103
AGENT_AUTH_ISSUER=http://localhost:4103
AGENT_AUTH_SIGNING_SECRET=dev-only-change-me-please
# VITE_AGENT_AUTH_API_URL=http://localhost:4103
# AGENT_AUTH_API_PROXY_TARGET=http://localhost:4103
GATE_STATE_BACKEND=memory
GATE_DYNAMO_TABLE=zexvro-agent-auth
GATE_REQUIRE_POP=true
# Gate admin (production defaults to true). Local tests leave false.
GATE_ADMIN_REQUIRE_AUTH=false
# Legacy Gate/NFTo AWS auth remains unconfigured pending their Cloudflare migration.

# Optional: vision LLM human-captcha QA only (never commit real keys)
# Used by: npm run gate:captcha-llm-demo
# CODEXIN_API_BASE=https://api.codexin.lol/v1
# CODEXIN_API_KEY=
# CODEXIN_MODEL=grok-4.5

# --- Mail (Brevo transactional) — server only; never expose key as VITE_* ---
# Create key: https://app.brevo.com/settings/keys/api
# Sender must be verified in Brevo (Senders & Domains).
#
# Local: Vite middleware POST /api/invite/send → https://api.brevo.com
# Prod:  Lambda POST /api/invite/send → https://api.brevo.com
# Never point the browser at localhost:8080 for mail.
MAIL_PROVIDER="brevo"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@zexvro.in"
INVITE_SOURCE_EMAIL="noreply@zexvro.in"
BREVO_SENDER_NAME="ZEXVRO"
# Optional override for mail HTTP entry (defaults: local same-origin, prod API Gateway)
# VITE_MAIL_API_URL=""
VITE_API_URL="https://zexvro-platform-api.zexvro.workers.dev"
FRONTEND_URL="https://console.zexvro.in"
MAIL_ASSET_BASE_URL="https://console.zexvro.in"

