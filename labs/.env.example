# GEMINI_API_KEY: Optional AI Mentor. When empty the AI Mentor falls back to
# a deterministic demo response (no live model calls).
GEMINI_API_KEY=""

# APP_URL: The public URL where ZEXVRO Labs is hosted.
# Used for GitHub OAuth callback (APP_URL/auth/callback) and self-referential links.
APP_URL="http://localhost:3000"

# GitHub OAuth — create an app at https://github.com/settings/developers
# and register the callback URL:  <APP_URL>/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Session signing secret. In production inject via AWS Secrets Manager.
LABS_SESSION_SECRET="dev-only-change-me"

# Comma-separated GitHub usernames granted admin (Lab Builder / CMS) access.
# Default: the "zexvro" team account.
LABS_ADMIN_GITHUB_LOGINS="zexvro"

# AWS backend. memory = in-memory dev store; dynamo = AWS DynamoDB (production).
LABS_STATE_BACKEND="memory"
LABS_DYNAMO_REGION="us-east-1"
LABS_DYNAMO_TABLE="zexvro-labs"

# App Runner port
PORT=3000
