{
  "name": "@zexvro/labs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy:plan": "XDG_CONFIG_HOME=/home/wraient npx --yes wrangler@4.151.0 pages functions build --profile zexvro",
    "test": "node --import tsx --test src/backend/*.test.ts src/lib/assets.test.ts",
    "deploy": "npm run lint && npm test && npm run build:web && XDG_CONFIG_HOME=/home/wraient npx --yes wrangler@4.151.0 pages deploy dist --project-name labs --branch main --profile zexvro",
    "build:web": "vite build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1085.0",
    "@aws-sdk/lib-dynamodb": "^3.1085.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4"
  },
  "overrides": {
    "@grpc/grpc-js@1": "^1.13.6",
    "body-parser@1": "^1.20.9",
    "nanoid@3": "^3.3.18",
    "proxy-addr@2": "^2.0.8",
    "qs@6": "^6.16.1",
    "re2js@2": "^2.8.7",
    "source-map-js@1": "^1.2.2"
  }
}
