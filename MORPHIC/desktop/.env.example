# VROAI endpoint the app talks to (main process only). VROAI_URL in the environment overrides it.
MAIN_VITE_VROAI_URL=http://localhost:3000

# Optional: OpenRouter as the model provider (VROAI becomes the fallback). Keep real keys out of git.
# MAIN_VITE_OPENROUTER_API_KEY=sk-or-...
# MAIN_VITE_OPENROUTER_MODEL=provider/model-id,provider/fallback-model-id
