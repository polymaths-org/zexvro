{
  "name": "morphic-desktop",
  "productName": "Morph",
  "version": "0.1.0",
  "private": true,
  "description": "Morph desktop app: the MORPHIC harness UI",
  "author": "ZEXVRO <hello@zexvro.in>",
  "homepage": "https://zexvro.in",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "node scripts/dev-local.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "eval:harness": "electron-vite build && node evals/run.mjs",
    "eval:hard": "electron-vite build && node evals/run.mjs --cases=dense,resilience,impossible,opaque,auth,denied,transport",
    "test:eval": "node --test evals/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/lexend-tera": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
