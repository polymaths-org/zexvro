# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SpacetimeDB handshake registry (primary) — set to "off" to use local seed only
VITE_SPACETIMEDB_HOST="wss://maincloud.spacetimedb.com"
VITE_SPACETIMEDB_HANDSHAKE_DB="zexvro-handshake"
